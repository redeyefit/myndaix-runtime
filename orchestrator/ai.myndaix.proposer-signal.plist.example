<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Observe-only "skill class READY" email notifier. READ-ONLY on the ledger; opens NO PR and
  never runs the proposer. IDLE (no-op) until the send credential exists at
  ~/.myndaix/.secrets/env/gmail-notify.env (SMTP_USER / SMTP_PASS / NOTIFY_TO, chmod 600).
  Install (AFTER: green tests + provisioning that credential):
    cp orchestrator/ai.myndaix.proposer-signal.plist.example ~/Library/LaunchAgents/ai.myndaix.proposer-signal.plist
    launchctl load ~/Library/LaunchAgents/ai.myndaix.proposer-signal.plist
  Rollback (instant): launchctl unload ~/Library/LaunchAgents/ai.myndaix.proposer-signal.plist
    (or just remove the credential file — the job then no-ops on every fire).
  Runs once daily at 08:20 — a newly-ready class is not urgent. Replace /Users/you with the
  deploy user's home.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>ai.myndaix.proposer-signal</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/you/code/active/myndaix-runtime/orchestrator/proposer-signal.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>8</integer>
    <key>Minute</key>
    <integer>20</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>/Users/you/.myndaix/orchestrator/proposer-signal.out</string>
  <key>StandardErrorPath</key>
  <string>/Users/you/.myndaix/orchestrator/proposer-signal.out</string>
</dict>
</plist>
